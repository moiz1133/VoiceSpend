# ---------------------------------------------------------------------------
# Voicespend backend — environment configuration
# Copy this file to `.env` and fill in real values before running the app.
# Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# Environment name: local | staging | production
ENV=local

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
# Local dev points at the docker-compose Postgres instance.
# Staging/production point at the Supabase Postgres connection string
# (Session pooler / direct connection, asyncpg-compatible).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://voicespend:voicespend@localhost:5432/voicespend

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Supabase — used ONLY for Auth (JWT verification) and Storage.
# All application data access goes through DATABASE_URL / SQLAlchemy, never
# the Supabase client library, so we can migrate off Supabase later.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Legacy shared JWT secret (Project Settings -> API -> JWT Secret).
# Used for HS256 verification. Prefer SUPABASE_JWT_JWKS_URL when your project
# has JWT signing keys (asymmetric / ES256|RS256) enabled instead.
SUPABASE_JWT_SECRET=change-me

# Optional: JWKS URL for asymmetric JWT verification, e.g.
# https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# When set, this takes precedence over SUPABASE_JWT_SECRET.
SUPABASE_JWT_JWKS_URL=

# Expected JWT audience and issuer (defaults usually work for Supabase).
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=

# Service role key (server-side only, full privileges). Used for Storage
# access via storage/supabase_storage.py. NEVER expose to clients.
SUPABASE_SERVICE_KEY=change-me

# Supabase Storage bucket used by StorageBackend implementation.
SUPABASE_STORAGE_BUCKET=voicespend

# ---------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed origins. Use "*" only in local dev.
# ---------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=*

# ---------------------------------------------------------------------------
# Parse pipeline (Phase 4) — LLM extraction + speech-to-text.
# Provider/model are config, never hardcoded — swap either without a
# code change. Set *_MODEL to the current fast/cheap JSON-capable model
# for that provider; left blank here deliberately since model names move
# and get re-benchmarked often.
# ---------------------------------------------------------------------------

# LLM extraction provider: anthropic | gemini
LLM_PROVIDER=anthropic
# e.g. the current fast/cheap JSON-capable Claude or Gemini model
LLM_MODEL=

# STT (speech-to-text) provider, used by /api/v1/transcribe: groq | deepgram
STT_PROVIDER=groq
# e.g. the current Whisper model on Groq, or Deepgram's current model
STT_MODEL=

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# Hard timeout on the LLM call for the hot-path /parse endpoint (seconds).
# On timeout/error the endpoint still returns HTTP 200 with status=failed.
PARSE_TIMEOUT_S=3.0

# Max characters accepted by POST /parse; 422 if exceeded.
PARSE_MAX_TEXT_LENGTH=500

# Max multipart audio upload size for POST /transcribe (bytes); 413 if
# exceeded. Audio is held in memory only and never written to disk/DB/
# storage — see app/api/v1/parse.py.
MAX_AUDIO_BYTES=5242880

# Confidence-to-status thresholds: >=OK -> "ok", [LOW, OK) -> "low_confidence",
# <LOW -> "failed".
CONFIDENCE_OK_THRESHOLD=0.75
CONFIDENCE_LOW_THRESHOLD=0.4

# ---------------------------------------------------------------------------
# Langfuse — LLM/STT call tracing. Leave the keys blank to disable tracing
# entirely (local dev, CI); every tracing call becomes a no-op.
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Trace the STT transcript TEXT (never raw audio) for debugging parses.
# Set to false for stricter transcript-privacy compliance.
LANGFUSE_CAPTURE_TRANSCRIPT=true

# ---------------------------------------------------------------------------
# Metering & entitlements (Phase 5)
# Quota gates the paid LLM/STT calls on /api/v1/parse and /api/v1/transcribe
# only — POST /api/v1/sync ALWAYS accepts and stores valid records regardless
# of quota. See app/services/entitlements and app/services/metering.
# ---------------------------------------------------------------------------

# Free-tier monthly cap on newly-created expenses before /parse and
# /transcribe stop calling the LLM/STT and return status="quota_exceeded".
FREE_MONTHLY_LOG_QUOTA=20

# Shared secret configured in the RevenueCat dashboard (Project Settings ->
# Integrations -> Webhooks -> Authorization header). RevenueCat sends this
# as a plain Authorization header value — it is NOT an HMAC signature.
# Leave blank to hard-disable the webhook (every request gets 401).
REVENUECAT_WEBHOOK_AUTH=
